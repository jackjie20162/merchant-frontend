{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Global Dubai Travel - Merchant",
  "version": "0.1.0",
  "identifier": "com.code688.travel.merchant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "title": "Global Dubai Travel - Merchant Console",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false,
      "devtools": true
    }],
    "security": {"csp": null}
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"]
  },
  "plugins": {
    "sql": {"preload": ["sqlite:~/.merchant-frontend/app/app.db"]}
  }
}
